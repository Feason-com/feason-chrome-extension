{
  "manifest_version": 3,
  "name": "Feason \u2014 Study & Share",
  "short_name": "Feason",
  "description": "Study Scripture, ask Feasy, keep a private reading inbox, explore biblical words, and share Gleams beside any page.",
  "version": "1.4.0",
  "homepage_url": "https://www.feason.com/chrome-extension",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "identity",
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.feason.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "side_panel": {
    "default_path": "popup.html?surface=sidepanel"
  },
  "action": {
    "default_title": "Feason \u2014 Study & Share",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Post a Gleam from this tab"
    },
    "feason-study-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Feason page study tools"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "omnibox": {
    "keyword": "feason"
  }
}
